  textContent: "\u5357\u6EAA\u5E02\u516C\u5B89\u5C40\u5211\u4FA6\u652F\u961F \u8BAF\u95EE\u7B14\u5F55
    \u6848\u4EF6\u7F16\u53F7\uFF1ANX-2012-1103-021 \u7B14\u5F55\u6027\u8D28\uFF1A\u72AF\u7F6A\u5ACC\u7591\u4EBA\u53E3\u4F9B
    \u53D7\u7406\u8B66\u5458\uFF1A\u9648\u5EFA\u56FD \u8B66\u53F7\uFF1A0374 \u8BAF\u95EE\u65F6\u95F4\uFF1A2016\u5E746\u67086\u65E5
    \u8BAF\u95EE\u5730\u70B9\uFF1A\u5357\u6EAA\u5E02\u516C\u5B89\u5C40\u7B2C\u4E09\u8BAF\u95EE\u5BA4
    \u88AB\u8BAF\u95EE\u4EBA\uFF1A \u949F\u5FB7\u53D1 \u8EAB\u4EFD\u8BC1\u53F7\uFF1A
    410700197803124715 \u8054\u7CFB\u7535\u8BDD\uFF1A 15789567456 \u6848\u4EF6\u5173\u8054\uFF1A
    \u5357\u6EAA\u5E02\u5858\u5C3E\u6751\u513F\u7AE5\u62D0\u5356\u6848\uFF082012\u5E74\uFF0C\u949F\u5FB7\u53D1\u524D\u79D1\u72AF\u6848\u671F\u95F4\uFF09
    \u53E3\u4F9B\u6B63\u6587\uFF1A \u5173\u4E8E\u5858\u5C3E\u6751\u90A3\u8D77\u6848\u5B50\uFF0C\u6211\u4EA4\u4EE3\u5982\u4E0B\u3002
    \u90A3\u662F2012\u5E74\u7684\u4E8B\uFF0C\u6211\u5F53\u65F6\u5728\u5357\u6EAA\u5E02\u897F\u90CA\u4E00\u5E26\u6D3B\u52A8\uFF0C\u65E0\u610F\u95F4\u6CE8\u610F\u5230\u5858\u5C3E\u6751\u6709\u4E2A\u7537\u5B69\uFF0C\u516D\u4E03\u5C81\u7684\u6837\u5B50\uFF0C\u7236\u6BCD\u90FD\u5728\u5916\u9762\u6253\u5DE5\uFF0C\u957F\u671F\u8DDF\u7740\u7237\u7237\u5976\u5976\u4F4F\u3002\u8001\u4EBA\u5E74\u7EAA\u5927\u4E86\uFF0C\u7BA1\u4E0D\u4F4F\u5B69\u5B50\uFF0C\u90A3\u5B69\u5B50\u7ECF\u5E38\u4E00\u4E2A\u4EBA\u5728\u6751\u5B50\u91CC\u5916\u5934\u73A9\u3002
    \u90A3\u4E2A\u5B69\u5B50\u53EB\u4EC0\u4E48\u540D\u5B57\u6211\u5DF2\u7ECF\u8BB0\u4E0D\u5F97\u4E86\u3002
    \u6211\u6CA1\u6709\u4EB2\u81EA\u52A8\u624B\u3002\u6211\u628A\u5B69\u5B50\u7684\u60C5\u51B5\u2014\u2014\u4F4F\u5728\u54EA\u3001\u6BCF\u5929\u4EC0\u4E48\u65F6\u5019\u51FA\u95E8\u3001\u5BB6\u91CC\u51E0\u4E2A\u5927\u4EBA\u2014\u2014\u90FD\u544A\u8BC9\u4E86\u8001\u516D\uFF0C\u7531\u4ED6\u5B89\u6392\u4EBA\u53BB\u529E\u3002\u6211\u53EA\u662F\u63D0\u4F9B\u4E86\u4FE1\u606F\u3002
    \u4E8B\u540E\u8001\u516D\u7ED9\u4E86\u6211\u4E94\u5343\u5757\u94B1\uFF0C\u8BF4\u662F\u4ECB\u7ECD\u8D39\u3002
    \u4EE5\u4E0A\u5C5E\u5B9E\u3002 \u88AB\u8BAF\u95EE\u4EBA\u7B7E\u5B57\u786E\u8BA4\uFF1A
    \u949F\u5FB7\u53D1 \u8BAF\u95EE\u8B66\u5458\u7B7E\u5B57\uFF1A \u9648\u5EFA\u56FD
    \u5357\u6EAA\u5E02\u516C\u5B89\u5C40\u5211\u4FA6\u652F\u961F \u4E13\u7528\u6587\u4E66
    \u4E25\u7981\u5916\u4F20 "
