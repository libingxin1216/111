  textContent: "\u5357\u6EAA\u5E02\u516C\u5B89\u5C40\u5211\u4FA6\u652F\u961F \u5BA1\u8BAF\u6458\u8981
    \u6848\u4EF6\u7F16\u53F7\uFF1ANX-2016-0814-107 \u6587\u4EF6\u6027\u8D28\uFF1A\u5ACC\u7591\u4EBA\u4F9B\u8FF0\u6458\u8981\u6574\u7406
    \u6574\u7406\u8B66\u5458\uFF1A\u9648\u5EFA\u56FD \u8B66\u53F7\uFF1A0374  \u88AB\u5BA1\u8BAF\u4EBA\uFF1A
    \u949F\u5FB7\u53D1 \u6587\u4EF6\u8BF4\u660E\uFF1A \u672C\u6587\u4EF6\u7CFB\u5BF9\u949F\u5FB7\u53D1\u591A\u6B21\u5BA1\u8BAF\u4F9B\u8FF0\u5185\u5BB9\u7684\u6574\u7406\u6458\u8981\uFF0C\u4F9B\u4E13\u6848\u7EC4\u53C2\u9605\u3002
    2012\u5E74\uFF0C\u949F\u5FB7\u53D1\u5211\u6EE1\u91CA\u653E\u540E\uFF0C\u8F97\u8F6C\u6765\u5230\u5CAD\u5357\u8179\u5730\u6DF1\u5904\u7684\u60E0\u8FDC\u5E02\u7D2B\u91D1\u53BF\u843D\u4E91\u5C6F\u3002\u636E\u5176\u4F9B\u8FF0\uFF0C\u9009\u62E9\u6B64\u5730\u5E76\u975E\u5076\u7136\u2014\u2014\u843D\u4E91\u5C6F\u5730\u5904\u504F\u50FB\uFF0C\u5916\u6765\u4EBA\u53E3\u6D41\u52A8\u6027\u5F3A\uFF0C\u7BA1\u7406\u677E\u6563\uFF0C\u662F\u4ED6\u6709\u610F\u6311\u9009\u7684\u843D\u811A\u4E4B\u5904\u3002
    \u6B64\u540E\u5177\u4F53\u4F5C\u6848\u7ECF\u8FC7\u53CA\u4EBA\u7269\u5173\u7CFB\uFF0C\u4ECD\u5728\u8FDB\u4E00\u6B65\u5BA1\u8BAF\u6838\u5B9E\u4E2D\uFF0C\u5F85\u8865\u5145\u5B8C\u5584\u3002
    \u5BA1\u8BAF\u8B66\u5458\u7B7E\u5B57\uFF1A \u9648\u5EFA\u56FD \u5357\u6EAA\u5E02\u516C\u5B89\u5C40\u5211\u4FA6\u652F\u961F
    \u4E13\u7528\u6587\u4E66 \u4E25\u7981\u5916\u4F20 "
